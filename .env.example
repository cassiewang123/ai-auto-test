# AIRETEST lightweight single-user configuration.
# Copy to .env. Generate private values for SECRET_KEY and
# SECRET_ENCRYPTION_KEY before keeping real data in the database.

APP_NAME=AI Test Platform
ENVIRONMENT=development
DEBUG=true

# SQLite is the default local database. Schema changes still use Alembic.
DATABASE_URL=sqlite:///./airetest-lite.db
DATABASE_ECHO=false
AUTO_CREATE_SCHEMA=false

# Execute queued jobs in a background thread inside the API process.
TASK_DISPATCH_MODE=local
TASK_FALLBACK_MODE=disabled
VITE_AIRETEST_MODE=lite
TASK_EAGER_IN_TESTS=true

# Optional Celery/Redis mode. Local mode ignores these queue values.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_SEND_SENT_EVENT=true
CELERY_WORKER_SEND_TASK_EVENTS=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_MAX_MEMORY_PER_CHILD=0
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true

SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=B05PSgXbYda2gKpXbQ_2YvL5P4MzlSlRV03Kpd64NqU=
SECRET_ENCRYPTION_KEY_VERSION=v1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 默认允许访问私网 / 本机地址（便于内网接口调试）；生产环境会强制要求 false
URL_ALLOW_PRIVATE=true
URL_ALLOWED_DOMAINS=
URL_BLOCKED_DOMAINS=

OPENAI_API_KEY=
LLM_MODEL=gpt-4
LLM_BASE_URL=

ALLOW_SYNC_EXECUTION=true
SCRIPT_EXECUTION_TIMEOUT=30
ARTIFACT_ROOT=.uploads
ALLOW_DIRECT_FILE_PATHS=false
